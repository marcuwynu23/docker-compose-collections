# Mixpost Configuration
# Copy this file to .env and update values

# === Application Settings
MIXPOST_APP_URL="http://localhost:8080"
MIXPOST_TRACKING_ENABLED="true"

# === Database Settings (auto-configured in docker-compose)
# MIXPOST_DB_HOST=db
# MIXPOST_DB_DATABASE=mixpost
# MIXPOST_DB_USER=mixpost
# MIXPOST_DB_PASSWORD=mixpost-password

# === Redis Settings (auto-configured in docker-compose)
# MIXPOST_REDIS_HOST=redis
# MIXPOST_REDIS_PASSWORD=

# === Social Media API Keys (optional)
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""
# TWITTER_API_KEY=""
# TWITTER_API_SECRET=""
# TWITTER_BEARER_TOKEN=""
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# INSTAGRAM_USERNAME=""
# INSTAGRAM_PASSWORD=""
# PINTEREST_APP_ID=""
# PINTEREST_APP_SECRET=""