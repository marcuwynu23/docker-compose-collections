SIGNOZ_PORT=8080
SIGNOZ_OTLP_GRPC_PORT=4317
SIGNOZ_OTLP_HTTP_PORT=4318

SIGNOZ_POSTGRES_DB=signoz
SIGNOZ_POSTGRES_USER=signoz
SIGNOZ_POSTGRES_PASSWORD=signoz

SIGNOZ_SQLSTORE_PROVIDER=postgres
SIGNOZ_SQLSTORE_POSTGRES_DSN=postgres://signoz:signoz@signoz-metastore-postgres-0:5432/signoz?sslmode=disable
SIGNOZ_TELEMETRYSTORE_PROVIDER=clickhouse
SIGNOZ_TELEMETRYSTORE_CLICKHOUSE_DSN=tcp://signoz-telemetrystore-clickhouse-0-0:9000

SIGNOZ_OTEL_RESOURCE_ATTRIBUTES=host.name=signoz-host,os.type=linux
SIGNOZ_LOW_CARDINAL_EXCEPTION_GROUPING=false
SIGNOZ_OTEL_COLLECTOR_CLICKHOUSE_REPLICATION=true

# Sample application
APP_PORT=5000
NODE_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-ingester:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=express-app
APP_VERSION=1.0.0
