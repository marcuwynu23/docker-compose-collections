{
  "openapi": "3.0.0",
  "info": {
    "title": "OrderAPI",
    "version": "1.0.0",
    "description": "Orders backend API served by the Node.js app (app/server.js). Exposed through the WSO2 stack: Client -> APIM :8243 -> MI :8290 -> app :3000.",
    "contact": {
      "name": "WSO2 APIM + MI demo"
    }
  },
  "x-wso2-basePath": "/orders",
  "x-wso2-production-endpoints": {
    "urls": [
      "http://wso2-mi:8290"
    ]
  },
  "x-wso2-sandbox-endpoints": {
    "urls": [
      "http://wso2-mi:8290"
    ]
  },
  "x-wso2-throttling-tier": "Unlimited",
  "servers": [
    {
      "url": "http://wso2-mi:8290",
      "description": "WSO2 Micro Integrator (integration layer)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Node.js backend (direct)"
    }
  ],
  "tags": [
    {
      "name": "Orders"
    },
    {
      "name": "Health"
    }
  ],
  "paths": {
    "/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get all orders",
        "operationId": "getOrders",
        "responses": {
          "200": {
            "description": "List of orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get an order by ID",
        "operationId": "getOrderById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric order ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "product": {
            "type": "string",
            "example": "Laptop"
          },
          "amount": {
            "type": "number",
            "example": 1200
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Order not found"
          }
        }
      }
    }
  }
}
